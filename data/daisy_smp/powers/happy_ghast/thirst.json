{
    "type": "origins:multiple",
    "resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 6000,
        "hud_render": {
            "sprite_location": "origins:textures/gui/resource_bar.png",
            "bar_index": 1
        }
    },
    "drink": {
        "type": "origins:action_on_item_use",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_resource",
            "change": 1200
        },
        "item_condition": {
            "type": "origins:or",
            "conditions": [
                {
                    "type": "origins:ingredient",
                    "ingredient": {
                        "item": "minecraft:potion"
                    }
                },
                {
                    "type": "origins:ingredient",
                    "ingredient": {
                        "item": "minecraft:honey_bottle"
                    }
                },
                {
                    "type": "origins:ingredient",
                    "ingredient": {
                        "item": "minecraft:ominous_bottle"
                    }
                }
            ]
        }
    },
    "wet": {
        "type": "origins:action_over_time",
        "interval": 20,
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_resource",
            "change": 6
        },
        "condition": {
            "type": "origins:or",
            "conditions": [
                {
                    "type": "origins:fluid_height",
                    "fluid": "minecraft:water",
                    "comparison": ">",
                    "compare_to": 0
                },
                {
                    "type": "origins:in_rain"
                }
            ]
        }
    },
    "dry": {
        "type": "origins:action_over_time",
        "interval": 20,
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_resource",
            "change": -10
        },
        "condition": {
            "type": "origins:or",
            "inverted": true,
            "conditions": [
                {
                    "type": "origins:fluid_height",
                    "fluid": "minecraft:water",
                    "comparison": ">",
                    "compare_to": 0
                },
                {
                    "type": "origins:in_rain"
                }
            ]
        }
    },
    "damage": {
        "type": "origins:damage_over_time",
        "interval": 20,
        "damage": 1,
        "damage_type": "daisy_smp:thirst",
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_resource",
            "comparison": "==",
            "compare_to": 0
        }
    },
    "respawn": {
        "type": "origins:action_on_callback",
        "entity_action_respawned": {
            "type": "origins:change_resource",
            "resource": "*:*_resource",
            "change": 6000
        },
        "entity_action_gained": {
            "type": "origins:change_resource",
            "resource": "*:*_resource",
            "change": 6000
        }
    }
}